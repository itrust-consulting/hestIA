{
  "roles": [
    { "name": "admin", "description": "Full system and data access" },
    { "name": "developer", "description": "Full system access with data stubs." },
    { "name": "moderator", "description": "Content management features for accessible collections." },
    { "name": "user", "description": "Standard user" },
    { "name": "guest", "description": "Restricted access" }
  ],

  "permissions": [
    { 
      "name": "user_management", 
      "description": "Create/edit/delete users", 
      "value_type": "boolean", 
      "options": {
        "labels": {
          "true": "Enabled",
          "false": "Disabled"
        },
        "default": false
      }
    },
    { 
      "name": "data_management", 
      "description": "Create/edit/delete knwoledge base data.", 
      "value_type": 
      "boolean", 
      "options": {
        "labels": {
          "true": "Enabled",
          "false": "Disabled"
        },
        "default": false
      }
    },
    { 
      "name": "system_management", 
      "description": 
      "Change system configuration.", 
      "value_type": "boolean", 
      "options": {
        "labels": {
          "true": "Enabled",
          "false": "Disabled"
        },
        "default": false
      }
    },
    {
      "name": "allowed_collections",
      "description": "Access to document collections",
      "value_type": "map",
      "options": {
        "keys": {
          "source": "collections",
          "label": "Collection"
        },
        "value": {
          "type": "object",
          "fields": {
            "access": {
              "type": "boolean",
              "labels": {
                "true": "Allowed",
                "false": "Denied"
              },
              "default": false
            },
            "max_classification": {
              "type": "integer",
              "nullable": true,
              "allowed_values": [0, 1, 2, 3, 4],
              "labels": {
                "0": "Public",
                "1": "Internal",
                "2": "Confidential",
                "3": "Restricted",
                "4": "Secret",
                "null": "None"
              }
            }
          }
        }
      }
    }
  ],

  "role_permissions": [
    { "role": "guest", "permission": "allowed_collections", "value": {} },
    { 
      "role": "user", 
      "permission": "allowed_collections", 
      "value": 
        {"ITR ISMS": 
          {
            "access": true, 
            "max_classification": 1
          }
        } 
    },
    { "role": "moderator", "permission": "data_management", "value": true },
    {
      "role": "moderator",
      "permission": "allowed_collections",
      "value": {
        "*": {
          "access": true,
          "max_classification": 4
        }
      }
    },
    { "role": "admin", "permission": "user_management", "value": true },
    { "role": "admin", "permission": "system_management", "value": true },
    { "role": "admin", "permission": "data_management", "value": true },
    {
      "role": "admin",
      "permission": "allowed_collections",
      "value": {
        "*": {
          "access": true,
          "max_classification": 4
        }
      }
    }
  ],

  "organizations": [
    { "name": "itrust consulting", "abbreviation": "ITR" },
    { "name": "Communale de Betzdorf", "abbreviation": "ACBz"},
    { "name": "Gemeng Kaerjeng", "abbreviation": "ACK"},
    { "name": "Gemeng Manternach", "abbreviation": "ACM"},
    { "name": "Commune de Mertert", "abbreviation": "ACMt"},
    { "name": "Gemeng Nidderaanwen", "abbreviation": "ACN"},
    { "name": "Gemeng Rouspert Mompech", "abbreviation": "ACROMO"},
    { "name": "Gemeng Suessem", "abbreviation": "ACS"},
    { "name": "Gemeng Useldeng", "abbreviation": "ACU"},
    { "name": "Police de Grand Ducal", "abbreviation": "PGD"}
  ]
}
